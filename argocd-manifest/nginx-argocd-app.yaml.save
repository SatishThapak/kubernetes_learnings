apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: nginx-web
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://github.com/SatishThapak/kubernetes_learnings.git      targetRevision: main
    path: nginx-deploy                                            # folder containing Deployment/Service
  destination:
    server: https://kubernetes.default.svc
    namespace: webapps                                            # target namespace for nginx
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
